/* ==========================================================================
   SketchUp 2025 Modern Dark Theme (Qt 6 QSS)
   Optimized for natural toolbar scale & high-contrast material thumbnails
   ========================================================================== */

/* --------------------------------------------------------------------------
   Podstawowy reset kolorów kontenerów (bez globalnego QWidget)
   -------------------------------------------------------------------------- */
QMainWindow,
QDialog,
QFrame#centralWidget,
QLabel,
QGroupBox {
    color: #d4d4d4;
}

/* Ochrona widoku 3D OpenGL przed przesłanianiem */
QOpenGLWidget,
QQuickWidget,
QGLWidget {
    background-color: transparent !important;
    border: none !important;
}

/* Główne kontenery aplikacji */
QMainWindow,
QDialog,
QFrame#centralWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   Pasek menu i menu kontekstowe
   -------------------------------------------------------------------------- */
QMenuBar {
    background-color: #252526;
    color: #cccccc;
    border-bottom: 1px solid #333333;
    padding: 1px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 3px 8px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #37373d;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #094771;
    color: #ffffff;
}

QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3e3e42;
    padding: 3px;
    border-radius: 4px;
}

QMenu::item {
    padding: 4px 22px 4px 22px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #656565;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #3e3e42;
    margin: 3px 4px;
}

/* --------------------------------------------------------------------------
   Paski narzędzi (Toolbars)
   Tło paska narzędzi ustawione na ciemne. Przyciski QToolButton NIE są
   modyfikowane przez QSS, co pozwala silnikowi QWindowsVistaStyle na zachowanie
   w 100% natywnej geometrii 1:1, identycznej jak w trybie jasnym!
   -------------------------------------------------------------------------- */
QToolBar {
    background-color: #252526;
    border: none;
}

/* --------------------------------------------------------------------------
   Tacki boczne (Zasobnik domyślny, panele KDDockWidgets i QDockWidget)
   -------------------------------------------------------------------------- */
QDockWidget {
    background-color: #252526;
    color: #ffffff;
    border: 1px solid #333333;
}

QDockWidget::title {
    background-color: #2d2d30;
    color: #ffffff;
    padding: 5px;
    border-bottom: 1px solid #3a3a3d;
    font-weight: 600;
}

KDDockWidgets--DockWidget,
KDDockWidgets--FrameWidget,
KDDockWidgets--SideBarWidget,
KDDockWidgets--TabBarWidget,
KDDockWidgets--TabWidgetWidget {
    background-color: #252526;
    color: #d4d4d4;
}

KDDockWidgets--TitleBarWidget,
KDDockWidgets--TitleBar {
    background-color: #2d2d30;
    color: #ffffff;
    border-bottom: 1px solid #3a3a3d;
    padding: 3px 6px;
}

KDDockWidgets--TitleBarWidget QLabel,
KDDockWidgets--TitleBar QLabel {
    color: #ffffff !important;
    font-weight: 600;
}

KDDockWidgets--Button,
KDDockWidgets--SideBarButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 2px;
    color: #cccccc;
    border-radius: 3px;
}

KDDockWidgets--Button:hover,
KDDockWidgets--SideBarButton:hover {
    background-color: #3e3e42;
    border-color: #555555;
}

/* --------------------------------------------------------------------------
   Kontenery paneli bocznych (Materiały, Informacje o elemencie, Style itp.)
   -------------------------------------------------------------------------- */
QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget,
QScrollArea::viewport,
QWidget#qt_scrollarea_viewport,
QAbstractScrollArea,
QAbstractScrollArea::viewport,
QStackedWidget {
    background-color: #252526 !important;
    color: #d4d4d4;
    border: none;
}

/* Sekcje rozwijane (Expander / Accordion / Nagłówki sekcji tacek) */
QFrame#collapsibleContent,
QWidget#collapsibleContent,
QFrame[class*="Expander"],
QWidget[class*="Expander"],
QFrame[class*="Page"],
QWidget[class*="Page"],
QFrame[class*="Dlg"],
QWidget[class*="Dlg"] {
    background-color: #252526 !important;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   Przeglądarka materiałów (CMaterialListCtrl, ContentBrowserListCtrl, CBrowserListCtrl)
   Miniatury folderów i materiałów posiadają białe tło podglądu.
   Dlatego ich etykiety tekstowe są ciemne (#111111) i pogrubione,
   co gwarantuje 100% czytelność bez zniekształcania podglądu materiału!
   -------------------------------------------------------------------------- */
CMaterialListCtrl,
CMaterialListCtrl *,
ContentBrowserListCtrl,
ContentBrowserListCtrl *,
CBrowserListCtrl,
CBrowserListCtrl *,
MaterialListCtrl,
MaterialListCtrl *,
MaterialListItem,
MaterialListItem *,
CMaterialBrowserPage,
CMaterialBrowserPage QWidget,
QWidget#materialsCtrl,
QWidget#materialsCtrl * {
    color: #111111 !important;
    font-weight: 700 !important;
}

/* Tło kontenera listy materiałów */
CMaterialListCtrl,
CMaterialListCtrl::viewport,
ContentBrowserListCtrl,
ContentBrowserListCtrl::viewport,
CBrowserListCtrl,
CBrowserListCtrl::viewport,
MaterialListCtrl,
MaterialListCtrl::viewport {
    background-color: #202022 !important;
    border: 1px solid #38383b;
    outline: none;
}

/* Kafelki miniatur materiałów i folderów */
CMaterialListCtrl::item,
ContentBrowserListCtrl::item,
CBrowserListCtrl::item,
MaterialListCtrl::item {
    background-color: #ffffff !important;
    color: #111111 !important;
    font-weight: 700 !important;
    border: 1px solid #999999 !important;
    border-radius: 4px;
    padding: 2px;
}

CMaterialListCtrl::item:hover,
ContentBrowserListCtrl::item:hover {
    background-color: #f0f0f0 !important;
    border: 2px solid #007acc !important;
    color: #000000 !important;
}

CMaterialListCtrl::item:selected,
ContentBrowserListCtrl::item:selected {
    background-color: #dbeafe !important;
    border: 2px solid #007acc !important;
    color: #003366 !important;
}

/* Pozostałe standardowe widoki list (np. Tagi, Konspekt) zachowują ciemne tło */
QTreeView,
QTreeView::viewport,
QTableView,
QTableView::viewport,
QListView,
QListView::viewport,
QListWidget,
QListWidget::viewport,
QTreeWidget,
QTreeWidget::viewport,
QAbstractItemView,
QAbstractItemView::viewport {
    background-color: #1e1e1e !important;
    color: #ffffff !important;
    border: 1px solid #38383b;
    outline: none;
}

QTreeView::item,
QTableView::item,
QListView::item {
    color: #d4d4d4 !important;
    background-color: transparent;
    padding: 2px 4px;
}

QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover {
    background-color: #2a2d2e !important;
    color: #ffffff !important;
}

QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected {
    background-color: #094771 !important;
    color: #ffffff !important;
}

/* Nagłówki tabel i widoków drzew */
QHeaderView::section {
    background-color: #2d2d30;
    color: #cccccc;
    border: 1px solid #333333;
    padding: 3px 5px;
    font-weight: 600;
}

/* --------------------------------------------------------------------------
   Edytory tekstu i Konsola Ruby
   -------------------------------------------------------------------------- */
QTextEdit,
QTextEdit::viewport,
QPlainTextEdit,
QPlainTextEdit::viewport {
    background-color: #1e1e1e !important;
    color: #f1f1f1 !important;
    border: 1px solid #3e3e42;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

/* --------------------------------------------------------------------------
   Kontrolki wejściowe (Pola tekstowe, SpinBoxy, ComboBoxy)
   -------------------------------------------------------------------------- */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: #2d2d30;
    color: #f1f1f1;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 2px 5px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #007acc;
    background-color: #333337;
}

QLineEdit:disabled,
QSpinBox:disabled {
    background-color: #222222;
    color: #555555;
    border-color: #2e2e2e;
}

QComboBox {
    background-color: #2d2d30;
    color: #f1f1f1;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 2px 6px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #555555;
    background-color: #333337;
}

QComboBox:focus {
    border-color: #007acc;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #3e3e42;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #454545;
    selection-background-color: #094771;
    selection-color: #ffffff;
    padding: 2px;
}

/* --------------------------------------------------------------------------
   Zakładki (Tabs)
   -------------------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #3a3a3d;
    background-color: #252526;
    top: -1px;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #969696;
    border: 1px solid #3a3a3d;
    border-bottom: none;
    padding: 4px 10px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:selected {
    background-color: #252526;
    color: #ffffff;
    border-top: 2px solid #007acc;
    border-bottom: 1px solid #252526;
}

QTabBar::tab:hover:!selected {
    background-color: #38383c;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   Przyciski standardowe
   -------------------------------------------------------------------------- */
QPushButton {
    background-color: #333337;
    color: #cccccc;
    border: 1px solid #454549;
    border-radius: 3px;
    padding: 4px 12px;
    min-width: 48px;
}

QPushButton:hover {
    background-color: #3e3e42;
    border-color: #55555a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #0e639c;
    border-color: #1177bb;
    color: #ffffff;
}

QPushButton:checked {
    background-color: #264f78;
    border: 1px solid #007acc;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #252526;
    color: #555555;
    border-color: #333333;
}

/* --------------------------------------------------------------------------
   Etykiety tekstowe
   -------------------------------------------------------------------------- */
QLabel {
    background-color: transparent;
    color: #d4d4d4;
}

QLabel:disabled {
    color: #656565;
}

/* --------------------------------------------------------------------------
   Pola wyboru i przyciski opcji (Checkbox & RadioButton)
   -------------------------------------------------------------------------- */
QCheckBox,
QRadioButton {
    spacing: 5px;
    color: #cccccc;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #ffffff;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4e4e52;
    background-color: #2d2d30;
    border-radius: 2px;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #007acc;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #007acc;
    border-color: #007acc;
}

/* --------------------------------------------------------------------------
   Paski przewijania (ScrollBars)
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 11px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 22px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:vertical:pressed {
    background-color: #606060;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 11px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 22px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #606060;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}

/* --------------------------------------------------------------------------
   Pasek stanu (StatusBar) i pomiary (VCB)
   -------------------------------------------------------------------------- */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    border-top: 1px solid #005a9e;
}

QStatusBar QLabel {
    color: #ffffff;
    padding: 2px 6px;
}

/* --------------------------------------------------------------------------
   Etykiety narzędzi (ToolTips)
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #2d2d30;
    color: #f1f1f1;
    border: 1px solid #454545;
    padding: 4px 7px;
    border-radius: 3px;
}

/* --------------------------------------------------------------------------
   Rozdzielacze okien (Splitters) i ramki grup (GroupBox)
   -------------------------------------------------------------------------- */
QSplitter::handle {
    background-color: #2d2d30;
}

QSplitter::handle:hover {
    background-color: #007acc;
}

QGroupBox {
    border: 1px solid #3e3e42;
    border-radius: 3px;
    margin-top: 6px;
    padding-top: 8px;
    color: #e0e0e0;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    background-color: #252526;
}
