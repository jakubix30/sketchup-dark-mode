/* ==========================================================================
   SketchUp 2025 Modern Dark Theme (Qt 6 QSS)
   Optimized for natural toolbar scale & high-contrast material thumbnails
   ========================================================================== */

/* --------------------------------------------------------------------------
   Container color reset (without global QWidget)
   -------------------------------------------------------------------------- */
QMainWindow,
QDialog,
QFrame#centralWidget,
QLabel,
QGroupBox {
    color: #d4d4d4;
}

/* Protect OpenGL 3D viewport from being occluded */
QOpenGLWidget,
QQuickWidget,
QGLWidget {
    background-color: transparent !important;
    border: none !important;
}

/* Main application containers */
QMainWindow,
QDialog,
QFrame#centralWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   Menu bar and context menus
   -------------------------------------------------------------------------- */
QMenuBar {
    background-color: #252526;
    color: #cccccc;
    border-bottom: 1px solid #333333;
    padding: 1px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 3px 8px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #37373d;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #094771;
    color: #ffffff;
}

QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3e3e42;
    padding: 3px;
    border-radius: 4px;
}

QMenu::item {
    padding: 4px 22px 4px 22px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #656565;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #3e3e42;
    margin: 3px 4px;
}

/* --------------------------------------------------------------------------
   Toolbars
   Toolbar background set to dark. QToolButtons are NOT styled by QSS,
   allowing QWindowsVistaStyle to preserve 100% native 1:1 geometry!
   -------------------------------------------------------------------------- */
QToolBar {
    background-color: #252526;
    border: none;
}

/* --------------------------------------------------------------------------
   Side trays (Default Tray, KDDockWidgets, and QDockWidget panels)
   -------------------------------------------------------------------------- */
QDockWidget {
    background-color: #252526;
    color: #ffffff;
}

QDockWidget::title {
    background-color: #2d2d30;
    color: #ffffff;
    padding: 5px;
    border-bottom: 1px solid #3a3a3d;
    font-weight: 600;
}

CDockingTray,
CDockingTray *,
CDockingTrayDialog,
CDockingTrayDialog *,
CDockingPanel,
CDockingPanel *,
CDockingPanelContainer,
CDockingPanelContainer *,
CPanelContentSplitter,
CPanelContentSplitter *,
CMaterialBrowser,
CMaterialBrowser *,
CMaterialBrowserPage,
CMaterialBrowserPage *,
CMaterialBrowserPreview,
CMaterialBrowserPreview *,
CMaterialEditPage,
CMaterialEditPage *,
MaterialsBrowser,
MaterialsBrowser *,
MaterialsBrowser2,
MaterialsBrowser2 *,
KDDockWidgets--DockWidget,
KDDockWidgets--DockWidget *,
KDDockWidgets--FrameWidget,
KDDockWidgets--FrameWidget *,
KDDockWidgets--SideBarWidget,
KDDockWidgets--SideBarWidget *,
KDDockWidgets--TabBarWidget,
KDDockWidgets--TabBarWidget *,
KDDockWidgets--TabWidgetWidget,
KDDockWidgets--TabWidgetWidget *,
QDockWidget,
QDockWidget *,
QScrollArea,
QScrollArea *,
QScrollArea > QWidget,
QScrollArea > QWidget *,
QFrame#collapsibleContent,
QFrame#collapsibleContent *,
QFrame[class*="Expander"],
QFrame[class*="Expander"] *,
QFrame[class*="Page"],
QFrame[class*="Page"] *,
QWidget[class*="Page"],
QWidget[class*="Page"] *,
QSplitter,
QSplitter * {
    background-color: #252526;
}

/* Tray text color - EXCLUDING material containers (so that #000000 !important at the end wins) */
CDockingTray,
CDockingTray *,
CDockingTrayDialog,
CDockingTrayDialog *,
CDockingPanel,
CDockingPanel *,
CDockingPanelContainer,
CDockingPanelContainer *,
CPanelContentSplitter,
CPanelContentSplitter *,
CMaterialEditPage,
CMaterialEditPage *,
KDDockWidgets--DockWidget,
KDDockWidgets--DockWidget *,
KDDockWidgets--FrameWidget,
KDDockWidgets--FrameWidget *,
KDDockWidgets--SideBarWidget,
KDDockWidgets--SideBarWidget *,
KDDockWidgets--TabBarWidget,
KDDockWidgets--TabBarWidget *,
KDDockWidgets--TabWidgetWidget,
KDDockWidgets--TabWidgetWidget *,
QDockWidget,
QDockWidget *,
QScrollArea,
QScrollArea *,
QScrollArea > QWidget,
QScrollArea > QWidget *,
QFrame#collapsibleContent,
QFrame#collapsibleContent *,
QSplitter,
QSplitter * {
    color: #d4d4d4;
}

/* Compact dimensions for tray controls (preventing minimum width expansion) */
CDockingTray QPushButton,
CDockingTray QToolButton,
CDockingTray QComboBox,
CDockingTray QLineEdit,
CDockingTray QTabBar::tab,
CDockingTray QPushButton,
CDockingTray QToolButton,
CDockingTray QComboBox,
CDockingTray QLineEdit,
CDockingTray QTabBar::tab,
CDockingTray QLabel,
CDockingTray QWidget,
QDockWidget QPushButton,
QDockWidget QToolButton,
QDockWidget QComboBox,
QDockWidget QLineEdit,
QDockWidget QTabBar::tab,
QDockWidget QLabel,
QDockWidget QWidget,
CMaterialBrowser QTabBar::tab,
CMaterialBrowserPage QTabBar::tab,
MaterialsBrowser QTabBar::tab,
CMaterialBrowserPage QPushButton,
CMaterialBrowserPage QToolButton,
CMaterialBrowserPage QComboBox,
CMaterialBrowserPage QLineEdit {
    padding: 1px 2px !important;
    min-width: 0px !important;
}

CMaterialBrowserPreview,
CMaterialBrowserPreview *,
CMaterialBrowserPreview QLabel,
CMaterialBrowserPreview QWidget {
    min-width: 0px !important;
    max-width: 100% !important;
}

KDDockWidgets--TitleBarWidget,
KDDockWidgets--TitleBar {
    background-color: #2d2d30;
    color: #ffffff;
    border-bottom: 1px solid #3a3a3d;
    padding: 3px 6px;
}

KDDockWidgets--TitleBarWidget QLabel,
KDDockWidgets--TitleBar QLabel {
    color: #ffffff !important;
    font-weight: 600;
}

KDDockWidgets--Button,
KDDockWidgets--SideBarButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 2px;
    color: #cccccc;
    border-radius: 3px;
}

KDDockWidgets--Button:hover,
KDDockWidgets--SideBarButton:hover {
    background-color: #3e3e42;
    border-color: #555555;
}

/* --------------------------------------------------------------------------
   Side panel containers (Materials, Entity Info, Styles, etc.)
   -------------------------------------------------------------------------- */
QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget,
QScrollArea::viewport,
QWidget#qt_scrollarea_viewport,
QAbstractScrollArea,
QAbstractScrollArea::viewport,
QStackedWidget {
    background-color: #252526 !important;
    color: #d4d4d4;
    border: none;
}

/* Collapsible sections (Expander / Accordion / Tray section headers) */
QFrame#collapsibleContent,
QWidget#collapsibleContent,
QFrame[class*="Expander"],
QWidget[class*="Expander"],
QFrame[class*="Page"],
QWidget[class*="Page"],
QFrame[class*="Dlg"],
QWidget[class*="Dlg"] {
    background-color: #252526 !important;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   Materials browser (CMaterialListCtrl, ContentBrowserListCtrl, CBrowserListCtrl)
   Thumbnail tiles for folders and swatches have clean white background.
   Text labels are rendered in crisp dark color with bottom padding.
   -------------------------------------------------------------------------- */

/* Materials list container background */
CMaterialListCtrl,
CMaterialListCtrl::viewport,
ContentBrowserListCtrl,
ContentBrowserListCtrl::viewport,
CBrowserListCtrl,
CBrowserListCtrl::viewport,
MaterialListCtrl,
MaterialListCtrl::viewport,
MaterialsBrowser QListView,
MaterialsBrowser QListView::viewport,
MaterialsBrowser2 QListView,
MaterialsBrowser2 QListView::viewport,
CMaterialBrowser QListView,
CMaterialBrowser QListView::viewport,
CMaterialBrowserPage QListView,
CMaterialBrowserPage QListView::viewport {
    background-color: #202022 !important;
    border: 1px solid #38383b !important;
    outline: none;
}

/* Dark text for material containers */
CMaterialListCtrl,
CMaterialListCtrl *,
ContentBrowserListCtrl,
ContentBrowserListCtrl *,
CBrowserListCtrl,
CBrowserListCtrl *,
MaterialListCtrl,
MaterialListCtrl *,
MaterialListItem,
MaterialListItem *,
CMaterialBrowserPage QListView,
CMaterialBrowserPage QListView *,
CMaterialBrowserPage QAbstractItemView,
CMaterialBrowserPage QAbstractItemView *,
MaterialsBrowser QListView,
MaterialsBrowser QListView *,
MaterialsBrowser2 QListView,
MaterialsBrowser2 QListView *,
CMaterialBrowser QListView,
CMaterialBrowser QListView * {
    color: #000000 !important;
}

/* Material thumbnail and folder tiles - transparent background with dark text */
CMaterialListCtrl::item,
ContentBrowserListCtrl::item,
CBrowserListCtrl::item,
CMaterialListCtrl::item,
ContentBrowserListCtrl::item,
CBrowserListCtrl::item,
MaterialListCtrl::item,
MaterialListItem,
CListBrowserItem,
ListContentBrowserItem,
MaterialsBrowser QListView::item,
MaterialsBrowser2 QListView::item,
CMaterialBrowser QListView::item,
CMaterialBrowserPage QListView::item,
CDockingTray MaterialsBrowser QListView::item,
CDockingTray CMaterialBrowser QListView::item,
CDockingTray CMaterialBrowserPage QListView::item {
    background-color: transparent !important;
    color: #000000 !important;
    font-size: 8pt !important;
    border: none !important;
    padding-top: 0px !important;
    padding-left: 0px !important;
    padding-right: 0px !important;
    padding-bottom: 2px !important;
    margin: 0px !important;
}

CMaterialListCtrl::item:hover,
ContentBrowserListCtrl::item:hover,
CBrowserListCtrl::item:hover,
MaterialListCtrl::item:hover,
MaterialsBrowser QListView::item:hover,
MaterialsBrowser2 QListView::item:hover,
CMaterialBrowser QListView::item:hover,
CMaterialBrowserPage QListView::item:hover,
CDockingTray MaterialsBrowser QListView::item:hover,
CDockingTray CMaterialBrowserPage QListView::item:hover {
    background-color: #f0f0f0 !important;
    border: 2px solid #007acc !important;
    color: #000000 !important;
}

CMaterialListCtrl::item:selected,
ContentBrowserListCtrl::item:selected,
CBrowserListCtrl::item:selected,
MaterialListCtrl::item:selected,
MaterialsBrowser QListView::item:selected,
MaterialsBrowser2 QListView::item:selected,
CMaterialBrowser QListView::item:selected,
CMaterialBrowserPage QListView::item:selected,
CDockingTray MaterialsBrowser QListView::item:selected,
CDockingTray CMaterialBrowserPage QListView::item:selected {
    background-color: #badcfc !important;
    border: 2px solid #007acc !important;
    color: #002244 !important;
}

/* Materials panel controls (dropdown, labels, buttons) - dark theme styling */
CMaterialBrowserPage QComboBox,
CMaterialBrowserPage QComboBox *,
QWidget#materialsCtrl QComboBox,
QWidget#materialsCtrl QComboBox *,
QComboBox#materialsComboBox,
QComboBox#materialCategories {
    background-color: #2d2d30 !important;
    color: #ffffff !important;
    font-weight: normal !important;
}

CMaterialBrowserPage QComboBox QAbstractItemView,
CMaterialBrowserPage QComboBox QAbstractItemView * {
    background-color: #252526 !important;
    color: #d4d4d4 !important;
}

CMaterialBrowserPage,
CMaterialBrowserPage QLabel,
CMaterialBrowserPage QToolButton,
CMaterialBrowserPage QPushButton {
    color: #d4d4d4 !important;
}

/* Other standard list views (e.g. Tags, Outliner) retain dark background */
QTreeView,
QTreeView::viewport,
QTableView,
QTableView::viewport,
QListWidget,
QListWidget::viewport,
QTreeWidget,
QTreeWidget::viewport,
QAbstractItemView,
QAbstractItemView::viewport {
    background-color: #1e1e1e !important;
    color: #ffffff !important;
    border: 1px solid #38383b;
    outline: none;
}

QTreeView::item,
QTableView::item {
    color: #d4d4d4 !important;
    background-color: transparent;
    padding: 2px 4px;
}

QTreeView::item:hover,
QTableView::item:hover {
    background-color: #2a2d2e !important;
    color: #ffffff !important;
}

QTreeView::item:selected,
QTableView::item:selected {
    background-color: #094771 !important;
    color: #ffffff !important;
}


/* Table and tree view headers */
QHeaderView::section {
    background-color: #2d2d30;
    color: #cccccc;
    border: 1px solid #333333;
    padding: 3px 5px;
    font-weight: 600;
}

/* --------------------------------------------------------------------------
   Text editors and Ruby Console
   -------------------------------------------------------------------------- */
QTextEdit,
QTextEdit::viewport,
QPlainTextEdit,
QPlainTextEdit::viewport {
    background-color: #1e1e1e !important;
    color: #f1f1f1 !important;
    border: 1px solid #3e3e42;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

/* --------------------------------------------------------------------------
   Input controls (LineEdits, SpinBoxes, ComboBoxes)
   -------------------------------------------------------------------------- */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: #2d2d30;
    color: #f1f1f1;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 1px 3px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #007acc;
    background-color: #333337;
}

QLineEdit:disabled,
QSpinBox:disabled {
    background-color: #222222;
    color: #555555;
    border-color: #2e2e2e;
}

QComboBox {
    background-color: #2d2d30;
    color: #f1f1f1;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 1px 4px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #555555;
    background-color: #333337;
}

QComboBox:focus {
    border-color: #007acc;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 14px;
    border-left: 1px solid #3e3e42;
}

QComboBox QAbstractItemView,
QComboBox QListView {
    background-color: #252526 !important;
    color: #d4d4d4 !important;
    border: 1px solid #454545 !important;
    selection-background-color: #094771 !important;
    selection-color: #ffffff !important;
    padding: 2px !important;
    outline: none !important;
}

QComboBox QAbstractItemView::item,
QComboBox QListView::item {
    background-color: transparent !important;
    color: #d4d4d4 !important;
    border: none !important;
    border-radius: 2px !important;
    padding: 3px 8px !important;
    min-height: 20px !important;
    font-weight: normal !important;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QListView::item:hover {
    background-color: #37373d !important;
    color: #ffffff !important;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QListView::item:selected {
    background-color: #094771 !important;
    color: #ffffff !important;
}

/* --------------------------------------------------------------------------
   Tabs
   -------------------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #3a3a3d;
    background-color: #252526;
    top: -1px;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #969696;
    border: 1px solid #3a3a3d;
    border-bottom: none;
    padding: 2px 4px;
    margin-right: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-width: 0px;
}

QTabBar::tab:selected {
    background-color: #252526;
    color: #ffffff;
    border-top: 2px solid #007acc;
    border-bottom: 1px solid #252526;
}

QTabBar::tab:hover:!selected {
    background-color: #38383c;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   Standard push buttons
   -------------------------------------------------------------------------- */
QPushButton {
    background-color: #333337;
    color: #cccccc;
    border: 1px solid #454549;
    border-radius: 3px;
    padding: 2px 6px;
    min-width: 0px;
}

QMessageBox QPushButton {
    min-width: 60px;
    padding: 4px 12px;
}

QPushButton:hover {
    background-color: #3e3e42;
    border-color: #55555a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #0e639c;
    border-color: #1177bb;
    color: #ffffff;
}

QPushButton:checked {
    background-color: #264f78;
    border: 1px solid #007acc;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #252526;
    color: #555555;
    border-color: #333333;
}

/* --------------------------------------------------------------------------
   Labels
   -------------------------------------------------------------------------- */
QLabel {
    background-color: transparent;
    color: #d4d4d4;
}

QLabel:disabled {
    color: #656565;
}

/* --------------------------------------------------------------------------
   Checkboxes and Radio buttons
   -------------------------------------------------------------------------- */
QCheckBox,
QRadioButton {
    spacing: 5px;
    color: #cccccc;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #ffffff;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4e4e52;
    background-color: #2d2d30;
    border-radius: 2px;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #007acc;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #007acc;
    border-color: #007acc;
}

/* --------------------------------------------------------------------------
   Shadows toolbar and sliders (QSlider)
   -------------------------------------------------------------------------- */
QToolBar,
QToolBar QLabel,
QToolBar QSlider,
QToolBar QSlider QLabel,
QSlider,
QSlider QLabel,
CShadowsPage,
CShadowsPage *,
CShadowPage,
CShadowPage *,
ShadowsBrowser,
ShadowsBrowser * {
    color: #e0e0e0 !important;
}

/* --------------------------------------------------------------------------
   Scroll bars
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 11px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 22px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:vertical:pressed {
    background-color: #606060;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 11px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 22px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #606060;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}

/* --------------------------------------------------------------------------
   Status bar and Measurements (VCB)
   -------------------------------------------------------------------------- */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    border-top: 1px solid #005a9e;
}

QStatusBar QLabel {
    color: #ffffff;
    padding: 2px 6px;
}

/* --------------------------------------------------------------------------
   Tooltips
   -------------------------------------------------------------------------- */
QToolTip,
QToolTip QLabel,
QTipLabel,
QTipLabel QLabel {
    background-color: #252526 !important;
    color: #ffffff !important;
    border: 1px solid #555555 !important;
    padding: 4px 7px;
    border-radius: 3px;
}

/* --------------------------------------------------------------------------
   Splitters and GroupBoxes
   -------------------------------------------------------------------------- */
QSplitter::handle {
    background-color: #2d2d30;
}

QSplitter::handle:hover {
    background-color: #007acc;
}

QGroupBox {
    border: 1px solid #3e3e42;
    border-radius: 3px;
    margin-top: 6px;
    padding-top: 8px;
    color: #e0e0e0;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    background-color: #252526;
}

/* ==========================================================================
   MATERIAL FOLDER & THUMBNAIL LABELS (CMaterialListCtrl)
   Enforces black text (color: #000000 !important) on white swatch backgrounds
   in the Materials panel. Positioned at the end of stylesheet to ensure specificity.
   ========================================================================== */
CMaterialListCtrl,
CMaterialListCtrl *,
CMaterialListCtrl::item,
ContentBrowserListCtrl,
ContentBrowserListCtrl *,
ContentBrowserListCtrl::item,
CBrowserListCtrl,
CBrowserListCtrl *,
CBrowserListCtrl::item,
MaterialListCtrl,
MaterialListCtrl *,
MaterialListCtrl::item,
MaterialListItem,
MaterialListItem *,
CListBrowserItem,
CListBrowserItem *,
ListContentBrowserItem,
ListContentBrowserItem *,
QWidget#materialsCtrl,
QWidget#materialsCtrl *,
QWidget#materialsCtrl QAbstractItemView,
QWidget#materialsCtrl QAbstractItemView *,
QWidget#materialsCtrl QAbstractItemView::item,
QWidget#materialsCtrl QListView,
QWidget#materialsCtrl QListView *,
QWidget#materialsCtrl QListView::item,
CMaterialBrowserPage QAbstractItemView,
CMaterialBrowserPage QAbstractItemView *,
CMaterialBrowserPage QAbstractItemView::item,
CMaterialBrowserPage QListView,
CMaterialBrowserPage QListView *,
CMaterialBrowserPage QListView::item,
MaterialsBrowser QAbstractItemView,
MaterialsBrowser QAbstractItemView *,
MaterialsBrowser QAbstractItemView::item,
MaterialsBrowser QListView,
MaterialsBrowser QListView *,
MaterialsBrowser QListView::item,
MaterialsBrowser2 QAbstractItemView,
MaterialsBrowser2 QAbstractItemView *,
MaterialsBrowser2 QAbstractItemView::item,
MaterialsBrowser2 QListView,
MaterialsBrowser2 QListView *,
MaterialsBrowser2 QListView::item,
CMaterialBrowser QAbstractItemView,
CMaterialBrowser QAbstractItemView *,
CMaterialBrowser QAbstractItemView::item,
CMaterialBrowser QListView,
CMaterialBrowser QListView *,
CMaterialBrowser QListView::item,
CDockingTray CMaterialBrowserPage QAbstractItemView,
CDockingTray CMaterialBrowserPage QAbstractItemView *,
CDockingTray CMaterialBrowserPage QAbstractItemView::item,
CDockingTray MaterialsBrowser QAbstractItemView,
CDockingTray MaterialsBrowser QAbstractItemView *,
CDockingTray MaterialsBrowser QAbstractItemView::item {
    color: #000000 !important;
}


/* Material tile hover and selection interactions */
CMaterialListCtrl::item:hover,
ContentBrowserListCtrl::item:hover,
CBrowserListCtrl::item:hover,
MaterialListCtrl::item:hover,
QWidget#materialsCtrl QAbstractItemView::item:hover,
CMaterialBrowserPage QAbstractItemView::item:hover,
MaterialsBrowser QAbstractItemView::item:hover {
    background-color: #f0f0f0 !important;
    border: 2px solid #007acc !important;
    color: #000000 !important;
}

CMaterialListCtrl::item:selected,
ContentBrowserListCtrl::item:selected,
CBrowserListCtrl::item:selected,
MaterialListCtrl::item:selected,
QWidget#materialsCtrl QAbstractItemView::item:selected,
CMaterialBrowserPage QAbstractItemView::item:selected,
MaterialsBrowser QAbstractItemView::item:selected {
    background-color: #dbeafe !important;
    border: 2px solid #007acc !important;
    color: #002244 !important;
}

/* Protect materials panel navigation controls - dropdown and text input */
CMaterialBrowserPage QComboBox,
CMaterialBrowserPage QComboBox *,
CMaterialBrowserPage QComboBox QAbstractItemView,
CMaterialBrowserPage QComboBox QAbstractItemView *,
CMaterialBrowserPage QComboBox QAbstractItemView::item,
CMaterialBrowserPage QComboBox QListView,
CMaterialBrowserPage QComboBox QListView *,
CMaterialBrowserPage QComboBox QListView::item,
CMaterialBrowserPage QLineEdit,
CMaterialBrowserPage QLineEdit *,
CMaterialBrowserPage QToolButton,
CMaterialBrowserPage QPushButton,
CMaterialBrowserPage QLabel#materialNameLabel,
QWidget#materialsCtrl QComboBox,
QWidget#materialsCtrl QComboBox *,
QWidget#materialsCtrl QComboBox QAbstractItemView,
QWidget#materialsCtrl QComboBox QAbstractItemView *,
QWidget#materialsCtrl QComboBox QAbstractItemView::item,
QWidget#materialsCtrl QComboBox QListView,
QWidget#materialsCtrl QComboBox QListView *,
QWidget#materialsCtrl QComboBox QListView::item,
QWidget#materialsCtrl QLineEdit {
    color: #d4d4d4 !important;
    font-weight: normal !important;
}

/* ==========================================================================
   TOOLTIPS - GLOBAL WHITE TEXT OVERRIDE
   Ensures all hover tooltips in trays, toolbars, and panels display crisp
   white text (#ffffff) on dark background (#252526).
   ========================================================================== */
QToolTip,
QToolTip *,
QTipLabel,
QTipLabel *,
CDockingTray QToolTip,
CDockingTray QToolTip *,
QDockWidget QToolTip,
QDockWidget QToolTip *,
CMaterialBrowserPage QToolTip,
CMaterialBrowserPage QToolTip *,
QWidget#materialsCtrl QToolTip,
QWidget#materialsCtrl QToolTip * {
    background-color: #252526 !important;
    color: #ffffff !important;
    border: 1px solid #555555 !important;
    font-weight: normal !important;
}


