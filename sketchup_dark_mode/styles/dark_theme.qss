/* ==========================================================================
   SketchUp 2025 Modern Dark Theme (Qt 6 QSS)
   Optimized for natural toolbar scale & high-contrast material thumbnails
   ========================================================================== */

/* --------------------------------------------------------------------------
   Podstawowy reset kolorĂłw kontenerĂłw (bez globalnego QWidget)
   -------------------------------------------------------------------------- */
QMainWindow,
QDialog,
QFrame#centralWidget,
QLabel,
QGroupBox {
    color: #d4d4d4;
}

/* Ochrona widoku 3D OpenGL przed przesĹ‚anianiem */
QOpenGLWidget,
QQuickWidget,
QGLWidget {
    background-color: transparent !important;
    border: none !important;
}

/* GĹ‚Ăłwne kontenery aplikacji */
QMainWindow,
QDialog,
QFrame#centralWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   Pasek menu i menu kontekstowe
   -------------------------------------------------------------------------- */
QMenuBar {
    background-color: #252526;
    color: #cccccc;
    border-bottom: 1px solid #333333;
    padding: 1px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 3px 8px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #37373d;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #094771;
    color: #ffffff;
}

QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3e3e42;
    padding: 3px;
    border-radius: 4px;
}

QMenu::item {
    padding: 4px 22px 4px 22px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #656565;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #3e3e42;
    margin: 3px 4px;
}

/* --------------------------------------------------------------------------
   Paski narzÄ™dzi (Toolbars)
   TĹ‚o paska narzÄ™dzi ustawione na ciemne. Przyciski QToolButton NIE sÄ…
   modyfikowane przez QSS, co pozwala silnikowi QWindowsVistaStyle na zachowanie
   w 100% natywnej geometrii 1:1, identycznej jak w trybie jasnym!
   -------------------------------------------------------------------------- */
QToolBar {
    background-color: #252526;
    border: none;
}

/* --------------------------------------------------------------------------
   Tacki boczne (Zasobnik domyĹ›lny, panele KDDockWidgets i QDockWidget)
   -------------------------------------------------------------------------- */
QDockWidget {
    background-color: #252526;
    color: #ffffff;
}

QDockWidget::title {
    background-color: #2d2d30;
    color: #ffffff;
    padding: 5px;
    border-bottom: 1px solid #3a3a3d;
    font-weight: 600;
}

CDockingTray,
CDockingTray *,
CDockingTrayDialog,
CDockingTrayDialog *,
CDockingPanel,
CDockingPanel *,
CDockingPanelContainer,
CDockingPanelContainer *,
CPanelContentSplitter,
CPanelContentSplitter *,
CMaterialBrowser,
CMaterialBrowser *,
CMaterialBrowserPage,
CMaterialBrowserPage *,
CMaterialBrowserPreview,
CMaterialBrowserPreview *,
CMaterialEditPage,
CMaterialEditPage *,
MaterialsBrowser,
MaterialsBrowser *,
MaterialsBrowser2,
MaterialsBrowser2 *,
KDDockWidgets--DockWidget,
KDDockWidgets--DockWidget *,
KDDockWidgets--FrameWidget,
KDDockWidgets--FrameWidget *,
KDDockWidgets--SideBarWidget,
KDDockWidgets--SideBarWidget *,
KDDockWidgets--TabBarWidget,
KDDockWidgets--TabBarWidget *,
KDDockWidgets--TabWidgetWidget,
KDDockWidgets--TabWidgetWidget *,
QDockWidget,
QDockWidget *,
QScrollArea,
QScrollArea *,
QScrollArea > QWidget,
QScrollArea > QWidget *,
QFrame#collapsibleContent,
QFrame#collapsibleContent *,
QFrame[class*="Expander"],
QFrame[class*="Expander"] *,
QFrame[class*="Page"],
QFrame[class*="Page"] *,
QWidget[class*="Page"],
QWidget[class*="Page"] *,
QSplitter,
QSplitter * {
    background-color: #252526;
}

/* Kolor tekstu tacek - BEZ kontenerow materialow (aby kolor #000000 !important na koncu wygral) */
CDockingTray,
CDockingTray *,
CDockingTrayDialog,
CDockingTrayDialog *,
CDockingPanel,
CDockingPanel *,
CDockingPanelContainer,
CDockingPanelContainer *,
CPanelContentSplitter,
CPanelContentSplitter *,
CMaterialEditPage,
CMaterialEditPage *,
KDDockWidgets--DockWidget,
KDDockWidgets--DockWidget *,
KDDockWidgets--FrameWidget,
KDDockWidgets--FrameWidget *,
KDDockWidgets--SideBarWidget,
KDDockWidgets--SideBarWidget *,
KDDockWidgets--TabBarWidget,
KDDockWidgets--TabBarWidget *,
KDDockWidgets--TabWidgetWidget,
KDDockWidgets--TabWidgetWidget *,
QDockWidget,
QDockWidget *,
QScrollArea,
QScrollArea *,
QScrollArea > QWidget,
QScrollArea > QWidget *,
QFrame#collapsibleContent,
QFrame#collapsibleContent *,
QSplitter,
QSplitter * {
    color: #d4d4d4;
}

/* Kompaktowe wymiary wszystkich kontrolek w zasobniku (zdjÄ™cie ograniczenia minimalnej szerokoĹ›ci) */
CDockingTray QPushButton,
CDockingTray QToolButton,
CDockingTray QComboBox,
CDockingTray QLineEdit,
CDockingTray QTabBar::tab,
CDockingTray QLabel,
CDockingTray QWidget,
QDockWidget QPushButton,
QDockWidget QToolButton,
QDockWidget QComboBox,
QDockWidget QLineEdit,
QDockWidget QTabBar::tab,
QDockWidget QLabel,
QDockWidget QWidget,
CMaterialBrowser QTabBar::tab,
CMaterialBrowserPage QTabBar::tab,
MaterialsBrowser QTabBar::tab {
    padding: 1px 2px !important;
}

CMaterialBrowserPreview,
CMaterialBrowserPreview *,
CMaterialBrowserPreview QLabel,
CMaterialBrowserPreview QWidget {
    max-width: 100% !important;
}

KDDockWidgets--TitleBarWidget,
KDDockWidgets--TitleBar {
    background-color: #2d2d30;
    color: #ffffff;
    border-bottom: 1px solid #3a3a3d;
    padding: 3px 6px;
}

KDDockWidgets--TitleBarWidget QLabel,
KDDockWidgets--TitleBar QLabel {
    color: #ffffff !important;
    font-weight: 600;
}

KDDockWidgets--Button,
KDDockWidgets--SideBarButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 2px;
    color: #cccccc;
    border-radius: 3px;
}

KDDockWidgets--Button:hover,
KDDockWidgets--SideBarButton:hover {
    background-color: #3e3e42;
    border-color: #555555;
}

/* --------------------------------------------------------------------------
   Kontenery paneli bocznych (MateriaĹ‚y, Informacje o elemencie, Style itp.)
   -------------------------------------------------------------------------- */
QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget,
QScrollArea::viewport,
QWidget#qt_scrollarea_viewport,
QAbstractScrollArea,
QAbstractScrollArea::viewport,
QStackedWidget {
    background-color: #252526 !important;
    color: #d4d4d4;
    border: none;
}

/* Sekcje rozwijane (Expander / Accordion / NagĹ‚Ăłwki sekcji tacek) */
QFrame#collapsibleContent,
QWidget#collapsibleContent,
QFrame[class*="Expander"],
QWidget[class*="Expander"],
QFrame[class*="Page"],
QWidget[class*="Page"],
QFrame[class*="Dlg"],
QWidget[class*="Dlg"] {
    background-color: #252526 !important;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   PrzeglÄ…darka materiaĹ‚Ăłw (CMaterialListCtrl, ContentBrowserListCtrl, CBrowserListCtrl)
   Kafelki miniatur folderĂłw i prĂłbek posiadajÄ… czyste biaĹ‚e tĹ‚o (swatch).
   Ich etykiety tekstowe majÄ… kolor czarny (#000000) z mocnym pogrubieniem (800)
   i sÄ… lekko uniesione (padding-bottom: 2px), co gwarantuje doskonaĹ‚Ä… czytelnoĹ›Ä‡!
   -------------------------------------------------------------------------- */

/* TĹ‚o kontenera listy materiaĹ‚Ăłw */
CMaterialListCtrl,
CMaterialListCtrl::viewport,
ContentBrowserListCtrl,
ContentBrowserListCtrl::viewport,
CBrowserListCtrl,
CBrowserListCtrl::viewport,
MaterialListCtrl,
MaterialListCtrl::viewport,
MaterialsBrowser QListView,
MaterialsBrowser QListView::viewport,
MaterialsBrowser2 QListView,
MaterialsBrowser2 QListView::viewport,
CMaterialBrowser QListView,
CMaterialBrowser QListView::viewport,
CMaterialBrowserPage QListView,
CMaterialBrowserPage QListView::viewport {
    background-color: #202022 !important;
    border: 1px solid #38383b !important;
    outline: none;
}

/* Czarny, mocny, pogrubiony tekst kontenerĂłw materiaĹ‚Ăłw */
CMaterialListCtrl,
CMaterialListCtrl *,
ContentBrowserListCtrl,
ContentBrowserListCtrl *,
CBrowserListCtrl,
CBrowserListCtrl *,
MaterialListCtrl,
MaterialListCtrl *,
MaterialListItem,
MaterialListItem *,
CMaterialBrowserPage QListView,
CMaterialBrowserPage QListView *,
CMaterialBrowserPage QAbstractItemView,
CMaterialBrowserPage QAbstractItemView *,
MaterialsBrowser QListView,
MaterialsBrowser QListView *,
MaterialsBrowser2 QListView,
MaterialsBrowser2 QListView *,
CMaterialBrowser QListView,
CMaterialBrowser QListView * {
    color: #000000 !important;
}

/* Kafelki miniatur materiaĹ‚Ăłw i folderĂłw - przezroczyste tĹ‚o z czarnym pogrubionym tekstem */
CMaterialListCtrl::item,
ContentBrowserListCtrl::item,
CBrowserListCtrl::item,
MaterialListCtrl::item,
MaterialListItem,
CListBrowserItem,
ListContentBrowserItem,
MaterialsBrowser QListView::item,
MaterialsBrowser QAbstractItemView::item,
MaterialsBrowser2 QListView::item,
MaterialsBrowser2 QAbstractItemView::item,
CMaterialBrowser QListView::item,
CMaterialBrowser QAbstractItemView::item,
CMaterialBrowserPage QListView::item,
CMaterialBrowserPage QAbstractItemView::item,
CDockingTray MaterialsBrowser QListView::item,
CDockingTray CMaterialBrowser QListView::item,
CDockingTray CMaterialBrowserPage QListView::item {
    background-color: transparent !important;
    color: #000000 !important;
    font-size: 8pt !important;
    border: none !important;
    padding-top: 0px !important;
    padding-left: 0px !important;
    padding-right: 0px !important;
    padding-bottom: 10px !important;
    margin: 0px !important;
}

CMaterialListCtrl::item:hover,
ContentBrowserListCtrl::item:hover,
CBrowserListCtrl::item:hover,
MaterialListCtrl::item:hover,
MaterialsBrowser QListView::item:hover,
MaterialsBrowser QAbstractItemView::item:hover,
MaterialsBrowser2 QListView::item:hover,
MaterialsBrowser2 QAbstractItemView::item:hover,
CMaterialBrowser QListView::item:hover,
CMaterialBrowser QAbstractItemView::item:hover,
CMaterialBrowserPage QListView::item:hover,
CMaterialBrowserPage QAbstractItemView::item:hover,
CDockingTray MaterialsBrowser QListView::item:hover,
CDockingTray CMaterialBrowserPage QListView::item:hover {
    background-color: #f0f0f0 !important;
    border: 2px solid #007acc !important;
    color: #000000 !important;
}

CMaterialListCtrl::item:selected,
ContentBrowserListCtrl::item:selected,
CBrowserListCtrl::item:selected,
MaterialListCtrl::item:selected,
MaterialsBrowser QListView::item:selected,
MaterialsBrowser QAbstractItemView::item:selected,
MaterialsBrowser2 QListView::item:selected,
MaterialsBrowser2 QAbstractItemView::item:selected,
CMaterialBrowser QListView::item:selected,
CMaterialBrowser QAbstractItemView::item:selected,
CMaterialBrowserPage QListView::item:selected,
CMaterialBrowserPage QAbstractItemView::item:selected,
CDockingTray MaterialsBrowser QListView::item:selected,
CDockingTray CMaterialBrowserPage QListView::item:selected {
    background-color: #badcfc !important;
    border: 2px solid #007acc !important;
    color: #002244 !important;
}

/* Kontrolki panelu materiaĹ‚Ăłw (lista rozwijana "MateriaĹ‚y", etykiety, przyciski) - peĹ‚ny ciemny motyw z biaĹ‚ym tekstem */
CMaterialBrowserPage QComboBox,
CMaterialBrowserPage QComboBox *,
QWidget#materialsCtrl QComboBox,
QWidget#materialsCtrl QComboBox *,
QComboBox#materialsComboBox,
QComboBox#materialCategories {
    background-color: #2d2d30 !important;
    color: #ffffff !important;
    font-weight: normal !important;
}

CMaterialBrowserPage QComboBox QAbstractItemView,
CMaterialBrowserPage QComboBox QAbstractItemView * {
    background-color: #252526 !important;
    color: #d4d4d4 !important;
}

CMaterialBrowserPage,
CMaterialBrowserPage QLabel,
CMaterialBrowserPage QToolButton,
CMaterialBrowserPage QPushButton {
    color: #d4d4d4 !important;
}

/* PozostaĹ‚e standardowe widoki list (np. Tagi, Konspekt) zachowujÄ… ciemne tĹ‚o */
QTreeView,
QTreeView::viewport,
QTableView,
QTableView::viewport,
QListWidget,
QListWidget::viewport,
QTreeWidget,
QTreeWidget::viewport,
QAbstractItemView,
QAbstractItemView::viewport {
    background-color: #1e1e1e !important;
    color: #ffffff !important;
    border: 1px solid #38383b;
    outline: none;
}

QTreeView::item,
QTableView::item {
    color: #d4d4d4 !important;
    background-color: transparent;
    padding: 2px 4px;
}

QTreeView::item:hover,
QTableView::item:hover {
    background-color: #2a2d2e !important;
    color: #ffffff !important;
}

QTreeView::item:selected,
QTableView::item:selected {
    background-color: #094771 !important;
    color: #ffffff !important;
}


/* NagĹ‚Ăłwki tabel i widokĂłw drzew */
QHeaderView::section {
    background-color: #2d2d30;
    color: #cccccc;
    border: 1px solid #333333;
    padding: 3px 5px;
    font-weight: 600;
}

/* --------------------------------------------------------------------------
   Edytory tekstu i Konsola Ruby
   -------------------------------------------------------------------------- */
QTextEdit,
QTextEdit::viewport,
QPlainTextEdit,
QPlainTextEdit::viewport {
    background-color: #1e1e1e !important;
    color: #f1f1f1 !important;
    border: 1px solid #3e3e42;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

/* --------------------------------------------------------------------------
   Kontrolki wejĹ›ciowe (Pola tekstowe, SpinBoxy, ComboBoxy)
   -------------------------------------------------------------------------- */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit {
    background-color: #2d2d30;
    color: #f1f1f1;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 1px 3px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #007acc;
    background-color: #333337;
}

QLineEdit:disabled,
QSpinBox:disabled {
    background-color: #222222;
    color: #555555;
    border-color: #2e2e2e;
}

QComboBox {
    background-color: #2d2d30;
    color: #f1f1f1;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 1px 4px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #555555;
    background-color: #333337;
}

QComboBox:focus {
    border-color: #007acc;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 14px;
    border-left: 1px solid #3e3e42;
}

QComboBox QAbstractItemView,
QComboBox QListView {
    background-color: #252526 !important;
    color: #d4d4d4 !important;
    border: 1px solid #454545 !important;
    selection-background-color: #094771 !important;
    selection-color: #ffffff !important;
    padding: 2px !important;
    outline: none !important;
}

QComboBox QAbstractItemView::item,
QComboBox QListView::item {
    background-color: transparent !important;
    color: #d4d4d4 !important;
    border: none !important;
    border-radius: 2px !important;
    padding: 3px 8px !important;
    min-height: 20px !important;
    font-weight: normal !important;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QListView::item:hover {
    background-color: #37373d !important;
    color: #ffffff !important;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QListView::item:selected {
    background-color: #094771 !important;
    color: #ffffff !important;
}

/* --------------------------------------------------------------------------
   ZakĹ‚adki (Tabs)
   -------------------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #3a3a3d;
    background-color: #252526;
    top: -1px;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #969696;
    border: 1px solid #3a3a3d;
    border-bottom: none;
    padding: 2px 4px;
    margin-right: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-width: 0px;
}

QTabBar::tab:selected {
    background-color: #252526;
    color: #ffffff;
    border-top: 2px solid #007acc;
    border-bottom: 1px solid #252526;
}

QTabBar::tab:hover:!selected {
    background-color: #38383c;
    color: #d4d4d4;
}

/* --------------------------------------------------------------------------
   Przyciski standardowe
   -------------------------------------------------------------------------- */
QPushButton {
    background-color: #333337;
    color: #cccccc;
    border: 1px solid #454549;
    border-radius: 3px;
    padding: 2px 6px;
    min-width: 0px;
}

QDialog QPushButton,
QMessageBox QPushButton {
    min-width: 60px;
    padding: 4px 12px;
}

QPushButton:hover {
    background-color: #3e3e42;
    border-color: #55555a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #0e639c;
    border-color: #1177bb;
    color: #ffffff;
}

QPushButton:checked {
    background-color: #264f78;
    border: 1px solid #007acc;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #252526;
    color: #555555;
    border-color: #333333;
}

/* --------------------------------------------------------------------------
   Etykiety tekstowe
   -------------------------------------------------------------------------- */
QLabel {
    background-color: transparent;
    color: #d4d4d4;
}

QLabel:disabled {
    color: #656565;
}

/* --------------------------------------------------------------------------
   Pola wyboru i przyciski opcji (Checkbox & RadioButton)
   -------------------------------------------------------------------------- */
QCheckBox,
QRadioButton {
    spacing: 5px;
    color: #cccccc;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #ffffff;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4e4e52;
    background-color: #2d2d30;
    border-radius: 2px;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #007acc;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #007acc;
    border-color: #007acc;
}

/* --------------------------------------------------------------------------
   Pasek narzÄ™dzi Cienie (Shadows toolbar) oraz suwaki (QSlider)
   -------------------------------------------------------------------------- */
QToolBar,
QToolBar QLabel,
QToolBar QSlider,
QToolBar QSlider QLabel,
QSlider,
QSlider QLabel,
CShadowsPage,
CShadowsPage *,
CShadowPage,
CShadowPage *,
ShadowsBrowser,
ShadowsBrowser * {
    color: #e0e0e0 !important;
}

/* --------------------------------------------------------------------------
   Paski przewijania (ScrollBars)
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 11px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 22px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:vertical:pressed {
    background-color: #606060;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 11px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 22px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #606060;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}

/* --------------------------------------------------------------------------
   Pasek stanu (StatusBar) i pomiary (VCB)
   -------------------------------------------------------------------------- */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    border-top: 1px solid #005a9e;
}

QStatusBar QLabel {
    color: #ffffff;
    padding: 2px 6px;
}

/* --------------------------------------------------------------------------
   Etykiety narzÄ™dzi (ToolTips)
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #2d2d30;
    color: #f1f1f1;
    border: 1px solid #454545;
    padding: 4px 7px;
    border-radius: 3px;
}

/* --------------------------------------------------------------------------
   Rozdzielacze okien (Splitters) i ramki grup (GroupBox)
   -------------------------------------------------------------------------- */
QSplitter::handle {
    background-color: #2d2d30;
}

QSplitter::handle:hover {
    background-color: #007acc;
}

QGroupBox {
    border: 1px solid #3e3e42;
    border-radius: 3px;
    margin-top: 6px;
    padding-top: 8px;
    color: #e0e0e0;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    background-color: #252526;
}

/* ==========================================================================
   ETYKIETY FOLDERĂ“W I MINIATUR MATERIAĹĂ“W (CMaterialListCtrl)
   Wymuszenie czarnej, grubej czcionki (color: #000000 !important, font-weight: 800 !important)
   oraz lekkiego uniesienia tekstu (padding-bottom: 2px !important)
